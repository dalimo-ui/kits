{
  "name": "@dalimo/css",
  "version": "0.5.0",
  "description": "Dalimo CSS framework",
  "main": "dist/dalimo.css",
  "style": "dist/dalimo.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "watch:css": "sass --watch src/main.scss dist/dalimo.css --no-source-map",
    "build:dev": "sass src/main.scss dist/dalimo.css --no-source-map",
    "build:prod": "sass src/main.scss dist/dalimo.min.css --style=compressed --no-source-map",
    "build": "npm-run-all clean build:dev build:prod",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "ui",
    "framework",
    "dalimo",
    "scss"
  ],
  "author": "Mojtaba Fazelinia",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "sass": "^1.69.5",
    "npm-run-all": "^4.1.5",
    "live-server": "^1.2.2",
    "rimraf": "^5.0.5"
  }
}
